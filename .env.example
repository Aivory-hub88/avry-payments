# Database Connection
DATABASE_URL=postgresql://user:password@localhost:5432/aivery

# Service Configuration
PORT=3030
ENVIRONMENT=development

# JWT — must match the secret avry-backend signs user tokens with, otherwise
# every authenticated payment call is rejected.
JWT_SECRET=your_secret_key_here

# Shared secret for calling avry-backend's internal entitlement API. Without it
# a verified payment cannot be turned into real access.
INTERNAL_SERVICE_TOKEN=
AVRY_BACKEND_URL=http://avry-backend:8081

# Logging
LOG_LEVEL=INFO

# ── Midtrans Payment Gateway ─────────────────────────────────────────────────
# MIDTRANS_IS_PRODUCTION selects the API host, so it MUST agree with the keys:
#   sandbox keys are prefixed "SB-" (SB-Mid-server-…) -> MIDTRANS_IS_PRODUCTION=false
#   production keys have no prefix  (Mid-server-…)    -> MIDTRANS_IS_PRODUCTION=true
# A mismatch means calling one environment with the other's credentials, so every
# payment 401s. The service refuses to start in that state.
#
# SANDBOX
# MIDTRANS_SERVER_KEY=SB-Mid-server-xxxxxxxxxxxxxxxx
# MIDTRANS_CLIENT_KEY=SB-Mid-client-xxxxxxxxxxxxxxxx
# MIDTRANS_IS_PRODUCTION=false
#
# PRODUCTION
# MIDTRANS_SERVER_KEY=Mid-server-xxxxxxxxxxxxxxxx
# MIDTRANS_CLIENT_KEY=Mid-client-xxxxxxxxxxxxxxxx
# MIDTRANS_IS_PRODUCTION=true
#
# MOCK MODE (development only — leave both keys empty; refused when
# MIDTRANS_IS_PRODUCTION=true)
MIDTRANS_SERVER_KEY=
MIDTRANS_CLIENT_KEY=
MIDTRANS_IS_PRODUCTION=false

# Midtrans settles in IDR only, so every USD price is converted. The live market
# rate is fetched at runtime and FX_MARGIN_PERCENT is added on top; USD_IDR_RATE
# is only the fallback used when the provider is unreachable and nothing is cached.
FX_RATE_URL=https://open.er-api.com/v6/latest/USD
FX_MARGIN_PERCENT=1.0
FX_TTL_SECONDS=21600
USD_IDR_RATE=16300

# Where Snap returns the customer after checkout, and how long a payment link lives.
PAYMENT_FINISH_REDIRECT_URL=https://dashboard.aivory.id/dashboard/dashboard/payments
PAYMENT_EXPIRY_HOURS=24

# Register this URL in the Midtrans dashboard under
# Settings -> Configuration -> Payment Notification URL:
#   https://backend.aivory.id/payments/api/v1/payments/midtrans/webhook
#
# It must be the backend.aivory.id host, NOT api.aivory.id: the latter is
# Cloudflare-proxied and Cloudflare silently drops Midtrans' notifications (a
# server-to-server POST can never look like a browser, so bot detection eats it).
# backend.aivory.id is DNS-only and the origin cert already covers it.

# API Keys (as needed)
# OPENROUTER_KEY=your_key_here
